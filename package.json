{
  "name": "las-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --runExternalCode --noEmit && vp build && node scripts/build-output.mjs",
    "build:preview": "CLOUDFLARE_PREVIEW_BUILD=true pnpm run build",
    "preview": "vp preview",
    "deploy": "pnpm run build && cf deploy --prebuilt --mode production",
    "deploy:preview": "pnpm run build:preview && cf previews deploy --prebuilt --mode production",
    "prepare": "vp config"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.9",
    "@cloudflare/config": "0.30.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/content-mapper": "4.0.0-alpha.0",
    "cf": "1.0.0-beta.27",
    "sass": "^1.107.0",
    "skills": "^1.7.4",
    "typescript": "7.1.0-dev.20261105.1",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.16.1"
}
